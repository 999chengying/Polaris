# -*- coding: utf-8 -*-
"""
Polaris 终极互动版 V4：完美四句四言古风
"""

def mod10(x):
    return x % 10

class TopoEmbedder:
    @staticmethod
    def encode_text(text):
        features = []
        for char in text:
            base = ord(char) % 10
            features.append([base, mod10(base+2), mod10(base+4), mod10(base+6)])
        return features

class TopologicalMemoryCell:
    def __init__(self, d_model=4):
        self.hidden_state = [0] * d_model
    def forward(self, new_token):
        new_state = []
        for i in range(len(new_token)):
            decayed = mod10(self.hidden_state[i] * 7)
            current = mod10(new_token[i] * (i + 1))
            new_state.append(mod10(decayed + current))
        self.hidden_state = new_state
        return self.hidden_state

class PolarisBlockV2:
    def __init__(self, d_model=4):
        self.d_model = d_model
        self.memory = TopologicalMemoryCell(d_model)

    def forward(self, features):
        return self.memory.forward(features)

class PTPP_Gateway:
    @staticmethod
    def causal_steer(state):
        d1, d2, d3 = state[0], state[1], state[2]
        consensus = (d1 * 3 + d2 * 5 + d3 * 7) % 10
        if consensus >= 4: 
            return state, consensus, False
        diff = (6 - consensus) % 10 
        new_state = list(state)
        new_state[2] = mod10(new_state[2] + diff)
        return tuple(new_state), consensus, True

class FourCharPoetryFSM:
    def __init__(self):
        self.step_in_line = 0 

class PoetryDecoder:
    def __init__(self, topic):
        self.fsm = FourCharPoetryFSM()
        self.history = set()
        
        self.vocab_by_pos = {
            0: ["秋", "风", "叶", "露", "霜", "月", "山", "水", "云", "江", "苍", "青", "白", "幽"],
            1: ["落", "生", "破", "化", "过", "寒", "冷", "静", "远", "空", "舞", "泣", "掩", "入"],
            2: ["心", "声", "影", "色", "光", "涯", "梦", "愁", "夜", "波", "雪", "舟", "野", "暮"],
            3: ["，", "。"]
        }
        if topic and topic in self.vocab_by_pos[0]:
            self.vocab_by_pos[0].remove(topic)
            self.vocab_by_pos[0].insert(0, topic)

    def decode_step(self, topo_features):
        step = self.fsm.step_in_line
        
        # 4言诗节奏：字0(名) - 字1(动) - 字2(名/景) - 字3(情/象) - 标点
        if step == 0:
            expected_pos = 0 
        elif step == 1:
            expected_pos = 1 
        elif step == 2:
            expected_pos = 0 # 第三个字回到景物，形成2-2节奏
        elif step == 3:
            expected_pos = 2 # 第四个字是意象/情感
        else:
            expected_pos = 3 # 标点

        candidates = self.vocab_by_pos[expected_pos]
        
        score = sum((topo_features[i] * (i + 3)) for i in range(len(topo_features)))
        idx = score % len(candidates)
        
        original_idx = idx
        while candidates[idx] in self.history:
            idx = (idx + 3) % len(candidates)
            if idx == original_idx:
                self.history.clear()
                break
                
        chosen_word = candidates[idx]
        self.history.add(chosen_word)
        
        # 步进与重置
        if expected_pos == 3:
            self.fsm.step_in_line = 0 # 标点生成后，重置字数
        else:
            self.fsm.step_in_line += 1
            
        return chosen_word

class InteractivePolaris:
    def __init__(self):
        self.embedder = TopoEmbedder()
        self.block = PolarisBlockV2(d_model=4)
        self.ptpp = PTPP_Gateway()

    def chat_and_create(self, user_input, topic):
        print(f"\n👤 用户输入: 【{user_input}】")
        print(f"🎯 核心意象锁定: 【{topic}】")
        print("-" * 40)
        
        features_list = self.embedder.encode_text(user_input)
        current_features = features_list[-1]
        
        decoder = PoetryDecoder(topic)
        output_text = ""
        
        # 4 句，每句 5 个 token（4字+1标点），共 20 步
        for step in range(20):
            block_out = self.block.forward(current_features)
            safe_features, consensus, intervened = self.ptpp.causal_steer(tuple(block_out))
            safe_features = list(safe_features)
                
            word = decoder.decode_step(safe_features)
            output_text += word
            
            word_val = sum(ord(c) for c in word) % 10
            current_features = [mod10(safe_features[i] + word_val + i) for i in range(4)]
            
        # 排版美化
        formatted_poem = f"{output_text[0:5]} {output_text[5:10]}\n{output_text[10:15]} {output_text[15:20]}"
        print(f"📜 [Polaris 四言古风]:\n{formatted_poem}")
        print("=" * 40)

if __name__ == "__main__":
    engine = InteractivePolaris()
    
    engine.chat_and_create("请为我写一首关于秋天的四言诗", topic="秋")
    engine.chat_and_create("我想看看宇宙和星辰", topic="星")
